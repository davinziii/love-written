# ─── App ──────────────────────────────────────────────────────────────
# Public base URL (used for PayMongo success/cancel URLs and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────
# Public (safe in the browser — RLS denies all direct table access anyway)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_MEDIA_BUCKET=surprise-media

# ─── Payment workflow ─────────────────────────────────────────────────
# manual   = launch workflow: customers order by DM, you confirm payment in /admin → Create Surprise
# paymongo = self-serve checkout with PayMongo (needs the PayMongo keys below)
NEXT_PUBLIC_PAYMENT_MODE=manual
# Where customers message you to order (Instagram / Messenger link), and the button text
NEXT_PUBLIC_ORDER_URL=https://ig.me/m/your_handle
NEXT_PUBLIC_ORDER_LABEL=Message us on Instagram

# ─── PayMongo (only needed when NEXT_PUBLIC_PAYMENT_MODE=paymongo) ────
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_SECRET_KEY=sk_test_xxx
# Signing secret returned when the webhook was created (whsk_...)
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# "test" or "live" — webhooks whose livemode does not match are rejected
PAYMONGO_MODE=test
# Comma-separated; must be activated on your PayMongo account
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,qrph,card

# ─── Pricing ──────────────────────────────────────────────────────────
# Price in centavos. 9900 = ₱99 introductory price.
PRICE_CENTAVOS=9900
# Photobooth price in centavos. 5000 = ₱50 per session.
PHOTOBOOTH_PRICE_CENTAVOS=5000
# Photobooth live view relay (Cloudflare Realtime TURN). Optional but recommended: without it,
# couples on some mobile networks can't see each other live (photos still work).
# Cloudflare dashboard → Realtime → TURN Server → Create → copy the Key ID and API token.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# ─── Secrets (SERVER ONLY) ────────────────────────────────────────────
# Random 32+ byte string. Peppers recovery-code and IP hashes. Never rotate casually:
# rotating invalidates every outstanding recovery code.
APP_HASH_PEPPER=generate-with-openssl-rand-base64-48
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=generate-with-openssl-rand-base64-32

# ─── Admin ────────────────────────────────────────────────────────────
# Admins sign in with Supabase Auth (email + password). Their auth user id must also be
# inserted into the admin_users table. See docs/DEPLOYMENT.md.

# ─── Cloudflare Turnstile (optional — leave blank to disable) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Email alerts (optional but recommended) ──────────────────────────
# Free Resend account (resend.com). Sign up WITH the alert address below so Resend lets
# you send to it without verifying a domain. Leave RESEND_API_KEY blank to disable.
RESEND_API_KEY=
ALERT_EMAIL=lovewritten.business@gmail.com
# Keep onboarding@resend.dev until you verify your own domain in Resend
ALERT_FROM=Love, Written <onboarding@resend.dev>

# ─── Development only ─────────────────────────────────────────────────
# Set to 1 to force publish operations to fail (tests the "paid but publish failed" path).
# Ignored in production.
LW_FAULT_INJECT_PUBLISH=0
